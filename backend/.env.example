# Konfigurasi Backend KerjaArah

# Kunci moderator. WAJIB diisi string acak panjang saat deploy.
# Bila kosong, seluruh endpoint /api/admin/* ditutup (fail closed).
ADMIN_API_KEY=

PORT=8000
ENVIRONMENT=development

# Daftar origin frontend yang diizinkan, dipisah koma.
# Saat deploy, tambahkan domain Vercel, misalnya https://kerjaarah.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lokasi berkas SQLite. Kosongkan untuk pengembangan lokal (backend/kerjaarah.db).
# Saat deploy, arahkan ke volume persisten, misalnya /data/kerjaarah.db,
# agar laporan tidak hilang setiap kali kontainer dimulai ulang.
DATABASE_PATH=
