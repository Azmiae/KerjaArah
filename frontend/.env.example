# Konfigurasi Frontend KerjaArah

# Alamat backend FastAPI. Kosongkan untuk pengembangan lokal (http://127.0.0.1:8000).
# Saat deploy di Vercel, isi dengan URL backend di Railway/Render, TANPA garis miring
# di akhir, misalnya https://kerjaarah-api.up.railway.app
#
# Catatan: variabel VITE_ dibaca saat BUILD, bukan saat runtime. Setelah mengubahnya
# di dashboard Vercel, lakukan redeploy agar nilainya ikut tertanam.
VITE_API_BASE_URL=
